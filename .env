# Default source: brightdata | iplist. Monitor / Configure switcher changes it at runtime (no Chrome restart).
PROXY_PROVIDER=brightdata
# ---- IP list mode ----
# One proxy IP per line; blank lines and # comments ignored. A line may carry its own port
# ("1.2.3.4:8080"), otherwise PROXY_LIST_PORT is used. Edits apply to running bots within ~5s:
# only bots whose IP was removed switch, everyone else keeps their current IP.
PROXY_LIST_FILE=proxies.txt
# http (normal proxy, tunnels HTTPS via CONNECT) | https | socks4 | socks5
PROXY_LIST_PROTOCOL=http
PROXY_LIST_PORT=3128
PROXY_LIST_USERNAME=myproxy
PROXY_LIST_PASSWORD="Jay123456!"
# Minutes a rotated-away IP stays out of the pool. If nothing else is free, a cooling IP is reused anyway.
