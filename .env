# ============ Required (automated login) ============
VFS_USERNAME=qwrthnjyui@powerscrews.com
VFS_PASSWORD='R112233r@'

# ============ Chrome / CDP ============
# Playwright connectOverCDP target. Bot launches Chrome on this port if DevTools is not up.
BROWSER_CDP_URL=http://127.0.0.1:9222
# Optional launch overrides (Windows defaults in code if unset):
# CHROME_PATH can be either chrome.exe or a folder that contains chrome.exe
# (examples: C:\Program Files\Google\Chrome\Application\chrome.exe or C:\Users\Administrator\AppData\Local\Google\Chrome\Bin)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
#
# Profile: default is C:/vfs-bot-profile (shared fixed path across PCs).
# To override, set CHROME_USER_DATA_DIR (not the "Default" subfolder if you point to Chrome User Data root).
# Fully quit Chrome first — only one process may lock that directory.
# CHROME_USER_DATA_DIR="C:/vfs-bot-profile"
# If you use a non-default profile, set the folder name from chrome://version → "Profile path" (e.g. Default, Profile 1):
# CHROME_PROFILE_DIRECTORY=Default
#
# Or start Chrome yourself with the same --user-data-dir (and --profile-directory if needed) plus
# --remote-debugging-port matching BROWSER_CDP_URL; the bot will skip launching when DevTools is already up.
# BROWSER_CHANNEL=chrome
# BROWSER_HEADLESS=true
#
# ============ Proxy (optional, per-instance sticky) ============
# Each bot instance selects one proxy from PROXY_URLS using BOT_INSTANCE_ID (or profile folder name fallback).
# Keep the same BOT_INSTANCE_ID on restarts to keep sticky IP.
# PROXY_URLS supports comma/newline list. You can use placeholders:
#   {session}  -> stable sticky token derived from BOT_INSTANCE_ID (or PROXY_STICKY_SESSION_ID override)
#   {instance} -> BOT_INSTANCE_ID value
# This app uses an in-code local proxy tunnel (proxy-chain) so user:pass proxies are supported
# without browser extension or Windows proxy settings.
# Recommended format: http://user-session-{session}:pass@host:port
# Keep the same BOT_INSTANCE_ID for sticky IP; use a different BOT_INSTANCE_ID per bot instance for different IPs.
# IMPORTANT: close all Chrome windows before bot start when PROXY_URLS is set, so proxy launch args can apply.
# Example:
# PROXY_URLS=http://user-session-{session}:pass@host1:port,http://user-session-{session}:pass@host2:port
# BOT_INSTANCE_ID=bot-01
# PROXY_STICKY_SESSION_ID=custom-stick-01
# If unset, proxy is disabled and Chrome uses normal network.
PROXY_URLS=http://brd-customer-hl_0d8fb57c-zone-static-country-bd:c2zftzi7chlq@brd.superproxy.io:33335
# BOT_INSTANCE_ID=
# PROXY_STICKY_SESSION_ID=

# ============ Telegram ============
ENABLE_TELEGRAM=false
TELEGRAM_TOKEN=8230265016:AAFGJuOo5JwtkpTucnj5ncGxP84KCEEfXBU
TELEGRAM_CHAT_ID=6402145716

# ============ mail.tm OTP (optional) ============
# ENABLE_MAIL_TM_OTP=true → bot reads OTP via https://api.mail.tm (see https://api.mail.tm/#/ ) using VFS_USERNAME / VFS_PASSWORD.
# That email must be the mailbox you created with mail.tm; domains come from GET /domains (e.g. sharebot.net), not only “mail.tm”.
# Setup-form login uses that form’s email/password the same way.
ENABLE_MAIL_TM_OTP=true
# Verbose mail.tm + login OTP logs (default on). Set to false for shorter logs.
# MAIL_TM_VERBOSE=false
# MAIL_TM_OTP_TIMEOUT_MS=120000
# MAIL_TM_POLL_MS=4000
# After Sign In, ms to wait before first mail.tm poll (default 2500). Set 0 to disable.
# MAIL_TM_POST_SIGNIN_DELAY_MS=3000

# ============ VFS endpoints ============
VFS_LOGIN_ENDPOINT=https://visa.vfsglobal.com/ind/en/bgr/login
# Optional overrides: VFS_LOGIN_PAGE_URL, VFS_SLOT_ENDPOINT, VFS_POLLING_PAGE_URL

# lift-api: optional manual clientsource (overrides auto-capture). If empty, bot captures from browser POST to
# https://lift-api.vfsglobal.com/appointment/application (after login). Comment out or clear to use capture only.
# VFS_CLIENTSOURCE=""
# Max ms to wait for clientsource capture before save applicants (when VFS_CLIENTSOURCE unset). Default 180000.
# VFS_WAIT_CLIENTSOURCE_MS=180000

# Setup form at http://127.0.0.1:3847 — Submit starts full flow (login if needed, then polling + booking). Further submits still work for new poll batches / refresh.
# VFS_APPLICANT_UI=true
# VFS_APPLICANT_UI_PORT=3847
# VFS_APPLICANT_UI_TIMEOUT_MS=1800000
# VFS_APPLICANT_UI_OPEN_BROWSER=false

# ============ Polling ============
ENABLE_POLLING=true
POLLING_INTERVAL_MS=10000
# POLL_LIMIT: 0 = poll forever; N>0 = run N slot checks then exit poll loop (then bot continues to save applicants / fees / …).
POLL_LIMIT=2
# Center & category for slot polling and all lift-api booking calls (same payload shape)
VFS_SLOT_COUNTRY_CODE=ind
VFS_SLOT_MISSION_CODE=bgr
VFS_SLOT_VAC_CODE=HYD
VFS_SLOT_VISA_CATEGORY_CODE=Busi
# VFS_SLOT_PAY_CODE=
VFS_SLOT_ROLE_NAME=Individual

# ============ Save applicants API (lift-api POST /appointment/applicants) ============
