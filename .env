# ============ mail.tm OTP (optional) ============
# ENABLE_MAIL_TM_OTP=true → bot reads OTP via https://api.mail.tm (see https://api.mail.tm/#/ ) using VFS_USERNAME / VFS_PASSWORD.
# That email must be the mailbox you created with mail.tm; domains come from GET /domains (e.g. sharebot.net), not only “mail.tm”.
# Setup-form login uses that form’s email/password the same way.
ENABLE_MAIL_TM_OTP=true
# Verbose mail.tm + login OTP logs (default on). Set to false for shorter logs.
# MAIL_TM_VERBOSE=false
# MAIL_TM_OTP_TIMEOUT_MS=120000
# MAIL_TM_POLL_MS=4000
# After Sign In, ms to wait before first mail.tm poll (default 2500). Set 0 to disable.
# MAIL_TM_POST_SIGNIN_DELAY_MS=3000

# ============ VFS endpoints ============
VFS_LOGIN_ENDPOINT=https://visa.vfsglobal.com/ind/en/bgr/login
VFS_POLLING_PAGE_URL=https://visa.vfsglobal.com/ind/en/bgr/application-detail
# Optional overrides: VFS_LOGIN_PAGE_URL, VFS_SLOT_ENDPOINT, VFS_POLLING_PAGE_URL

# lift-api: optional manual clientsource (overrides auto-capture). If empty, bot captures from browser POST to
# https://lift-api.vfsglobal.com/appointment/application (after login). Comment out or clear to use capture only.
# VFS_CLIENTSOURCE=""
# Generate a fresh 256-byte random base64 clientsource for every lift-api request (saveApplicants, calendar,
# timeslot, fees, schedule).  Takes priority over VFS_CLIENTSOURCE and browser-captured values.
VFS_RANDOM_CLIENTSOURCE=false
# Max ms to wait for clientsource capture before save applicants (when VFS_CLIENTSOURCE unset). Default 180000.
# VFS_WAIT_CLIENTSOURCE_MS=180000

# Setup form at http://127.0.0.1:3847 — Submit starts full flow (login if needed, then polling + booking). Further submits still work for new poll batches / refresh.
# VFS_APPLICANT_UI=true
# VFS_APPLICANT_UI_PORT=3847
# If the port is busy, try this many consecutive ports (3847, 3848, …). Default 20, max 100.
# VFS_APPLICANT_UI_PORT_TRY=20
# VFS_APPLICANT_UI_TIMEOUT_MS=0   (0 or unset = run forever; set a positive ms value to auto-close after that time)
# VFS_APPLICANT_UI_OPEN_BROWSER=false

# ============ Polling ============
# Set VFS_LOGIN_ONLY=true to log in and stop immediately — no polling, no booking (useful for testing login / Turnstile).
VFS_LOGIN_ONLY=false
ENABLE_POLLING=true
# After N poll rounds, log out and re-login to get a fresh VFS session (resets the 429 rate-limit counter).
# 0 = disabled.  Recommended: 10 (one re-login per minute at 6 s intervals).
VFS_POLL_RELOGIN_INTERVAL=8
# When two VFS accounts are set in the setup UI: each poll relogin does logout → kill Chrome → next PROXY_URLS → new Chrome → other account login.
# false = same Chrome window (soft relogin only). Use multiple comma/newline proxies in PROXY_URLS to change egress IP each swap.
# VFS_CREDENTIAL_SWAP_BROWSER_RESTART=true
# Sleep between slot polls is FIXED_POLL_INTERVAL_MS (see “Fixed timing” below). config still exposes POLLING_INTERVAL_* but the main poll loop does not use them.
POLLING_INTERVAL_MIN_MS=20000
POLLING_INTERVAL_MAX_MS=60000
# POLLING_INTERVAL_MS=30000
# POLL_LIMIT: 0 = poll forever; N>0 = run N slot checks then exit poll loop (then bot continues to save applicants / fees / …).
POLL_LIMIT=0
# Center & category for slot polling and all lift-api booking calls (same payload shape).
# countryCode is normalized to lowercase; applicant nationalityCode to uppercase in save-applicants JSON.
VFS_SLOT_COUNTRY_CODE=ind
VFS_SLOT_MISSION_CODE=bgr
VFS_SLOT_VAC_CODE=HYD
VFS_SLOT_VISA_CATEGORY_CODE=Busi
# VFS_SLOT_PAY_CODE=
VFS_SLOT_ROLE_NAME=Individual

# ============ Save applicants API (lift-api POST /appointment/applicants) ============
# Optional: force ipAddress in payload (skips browser + Node lookup). Otherwise IP is taken from the first Chrome tab
# via in-page fetch (matches proxy extension) with Node fallback.
# VFS_APPLICANT_IP=203.0.113.1
VFS_SAVE_LANGUAGE_CODE=en-US
# Optional: full JSON body instead of fields below — VFS_APPLICANTS_JSON={"countryCode":"tza",...}
VFS_APPLICANT_FIRST_NAME=
VFS_APPLICANT_LAST_NAME=
VFS_APPLICANT_PASSPORT=
VFS_APPLICANT_PASSPORT_EXP=
VFS_APPLICANT_DOB=
VFS_APPLICANT_EMAIL=
VFS_APPLICANT_NATIONALITY=IND
VFS_APPLICANT_DIAL_CODE=
VFS_APPLICANT_PHONE=
VFS_APPLICANT_GENDER=1
# Applicant IP: prefer in-tab ipify fetch (Chrome egress); Node ipify + local NIC fallback if that fails.
# VFS_APPLICANT_SUBVISA_CATEGORY=
# VFS_APPLICANT_SUBCLASS_CODE=
# Force applicantList[0].selectedSubvisaCategory to JSON null after VFS_APPLICANTS_JSON / form merge (lift-api capture shape). Values: true, 1, yes
VFS_APPLICANT_SELECTED_SUBVISA_NULL=true
# VFS_SAVE_APPLICANTS_URL=https://lift-api.vfsglobal.com/appointment/applicants
# Optional: fees after save applicants (default lift-api /appointment/fees)
# VFS_FEES_URL=https://lift-api.vfsglobal.com/appointment/fees
# VFS_CALENDAR_URL=https://lift-api.vfsglobal.com/appointment/calendar
# VFS_TIMESLOT_URL=https://lift-api.vfsglobal.com/appointment/timeslot
# VFS_SCHEDULE_URL=https://lift-api.vfsglobal.com/appointment/schedule
# When true, schedule success still stores the payment URL but does not redirect the browser (testing only). Values: true, 1, yes
VFS_SKIP_SCHEDULE_PAYMENT_REDIRECT=false

# ============ CapMonster (Turnstile solve; optional) ============
ENABLE_CAPMONSTER=true
CAPMONSTER_API_KEY=cae8ea09dcfd25156573d0cc4455d398
CAPMONSTER_API_URL=https://api.capmonster.cloud
# Max time to wait for CapMonster to return a token (default in code: 120000)
# CAPMONSTER_MAX_WAIT_MS=180000

# ============ Turnstile demo mode (testing CapMonster) ============
# When true, clicking Submit opens TURNSTILE_DEMO_URL and runs Turnstile solve+inject there (no VFS flow).
TURNSTILE_DEMO_MODE=false
TURNSTILE_DEMO_URL=https://2captcha.com/demo/cloudflare-turnstile

# ============ Other ============
# LOG_LEVEL=info
# VFS_CF_CHALLENGE_RECOVERY_MODE=new_tab
# Schedule payload: VFS_SCHEDULE_CAN_REACHOUT, VFS_SCHEDULE_TNC, VFS_SCHEDULE_NOTIFICATION_TYPE
VFS_SCHEDULE_CAN_REACHOUT=false
FAST_SKIP_CALENDAR_UP_TO_INSTANCE=1

# ============ Fixed timing (optional) ============
# Instances 1..FIXED_TIMING_UP_TO_INSTANCE use a fixed poll interval (instead of random MIN/MAX).
# Set to 0 to disable fixed timing for all instances.
FIXED_TIMING_UP_TO_INSTANCE=11
# Fixed poll interval (ms) for instances in the fixed timing group.
FIXED_POLL_INTERVAL_MS=30000